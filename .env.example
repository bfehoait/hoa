# Real sign-in is the default. Use only owner-approved project settings.
# Copy to ignored .env.local for local development; never commit actual values.
VITE_APP_MODE=authenticated
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local dev inspection only: VITE_APP_MODE=preview (does not authenticate).
# Release builds always use authenticated mode, even if preview was requested.
